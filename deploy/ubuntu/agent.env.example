# Copy to /etc/insighthub/agent.env and never commit real values.
APP_ENV=production
AGENT_MOCK_LLM=false
ALLOW_SYNTHETIC_DEMO=false
AGENT_INTERNAL_TOKEN=replace-with-the-same-secret-used-by-Java
DEEPSEEK_API_KEY=replace-on-the-server
TAVILY_API_KEY=replace-on-the-server
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=insighthub_vector
POSTGRES_USER=insighthub
POSTGRES_PASSWORD=replace-with-a-random-password
REDIS_URL=redis://127.0.0.1:6379/0
ARTIFACT_ROOT_DIR=/opt/insighthub/artifacts
SANDBOX_ENABLED=true
SANDBOX_IMAGE=insighthub-analysis-sandbox:1.0.0
SANDBOX_TIMEOUT_SECONDS=120
DEFAULT_TIMEOUT_SECONDS=900
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_PIDS_LIMIT=64
ARTIFACT_MAX_COUNT=8
ARTIFACT_MAX_TOTAL_BYTES=20971520
CHECKPOINT_BACKEND=postgres
