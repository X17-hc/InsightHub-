# InsightHub 本地环境变量示例
# 复制为项目根目录 .env 后按需修改：
#   Copy-Item .env.example .env

# ---------- 运行模式 ----------
# native = 使用本机已安装的 MySQL / Redis / PostgreSQL
# docker = 使用 deploy/docker-compose.yml
INSIGHTHUB_INFRA_MODE=native

# ---------- MySQL（Java 业务库） ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=insighthub
MYSQL_USER=insighthub
MYSQL_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456
MYSQL_JDBC_URL=jdbc:mysql://127.0.0.1:3306/insighthub?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai

# ---------- Redis（缓存 / 锁 / 限流 / 事件） ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- PostgreSQL + PGVector（向量库） ----------
# native 模式：本机 PostgreSQL 16，端口 5432
# docker 模式：建议改成 5433，避免与本机服务冲突
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=insighthub_vector
POSTGRES_USER=insighthub
POSTGRES_PASSWORD=123456
# 超级用户仅用于初始化脚本，业务代码不要使用
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=123456
POSTGRES_URL=postgresql+psycopg://insighthub:123456@127.0.0.1:5432/insighthub_vector

# ---------- 应用服务 ----------
JAVA_SERVER_PORT=8080
PYTHON_AGENT_PORT=8000
# 至少 32 字符；Java 启动时短密钥会直接失败
JWT_SECRET=dev-only-change-me-please-use-long-secret
DEMO_SEED_ENABLED=true
DOCS_PUBLIC_ACCESS=true

# ---------- LLM / 搜索（第 1 周） ----------
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek:deepseek-v4-flash
# 可选：配置后 Researcher 走真实联网搜索，否则使用 SYNTHETIC 证据降级
TAVILY_API_KEY=
AGENT_BASE_URL=http://127.0.0.1:8000
