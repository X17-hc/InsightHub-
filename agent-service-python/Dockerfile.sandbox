# Immutable Docker Hub manifest, fetched through the reachable mirror. The
# digest makes the image content independent of a mutable tag or mirror state.
FROM docker.m.daocloud.io/library/python@sha256:9c900dea9e8fb7e16277c179b555cc72d29a352dbc33cff48ad5a0412fd5bfc7

# The Ubuntu VM uses the same reachable Tsinghua mirror as apt. Versions remain
# pinned; increased timeout/retries handle transient intra-network slowdowns.
RUN pip install --no-cache-dir \
    --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
    --timeout 120 --retries 5 \
    pandas==2.2.3 numpy==2.1.3 pyarrow==18.1.0 matplotlib==3.9.3
# The runtime command pins a numeric, non-root UID.  Do not create an account
# with UID 65534 here: Debian already reserves it for nobody.
USER 65534:65534
WORKDIR /work
